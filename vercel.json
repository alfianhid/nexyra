{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["bom1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{server/pathways/*.json,data/generator-assumptions.json}"
    }
  },
  "crons": [{ "path": "/api/demo/reset", "schedule": "0 21 * * *" }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

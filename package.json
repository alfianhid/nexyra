{
  "name": "nexyra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "server": "tsx watch server/index.ts",
    "seed": "tsx server/seed.ts",
    "test": "vitest run",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "demo:reset": "tsx server/reset.ts",
    "demo:reset:remote": "tsx --env-file=.env server/reset.ts",
    "verify:file": "tsx server/verify/cli.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.1.9"
  }
}

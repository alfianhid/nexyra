# Local development: a SQLite file (libSQL keeps its journal and WAL beside it).
DATABASE_FILE=data/nexyra.sqlite

# Deployed (Vercel): Turso. When TURSO_DATABASE_URL is set it wins over DATABASE_FILE.
# Set both in the Vercel project settings, never in git. Running `npm run demo:reset`
# with these two set resets the deployed database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Extraction model (TICKET-13). Leave the key empty to use cached results only.
# Any OpenAI-compatible endpoint; the code appends /chat/completions to LLM_BASE_URL.
# Switching provider is these three values only, e.g. Meta's Model API:
#   LLM_BASE_URL=https://api.meta.ai/v1   NEXYRA_MODEL=<the model id from Meta's dashboard>
LLM_BASE_URL=
LLM_API_KEY=
NEXYRA_MODEL=deepseek/deepseek-v4.1-flash-1017
# Per-call timeout in milliseconds (one retry follows a timeout). Default 30000.
LLM_TIMEOUT_MS=
